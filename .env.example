# SIAMS environment. Copy to .env (make init does this). Never commit .env.
# Inside docker compose the service names (db, redis, rabbitmq, mailpit) are
# the hosts. If you run Django on your host instead, use localhost.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
TIME_ZONE=Africa/Nairobi
LOG_LEVEL=INFO
LOG_JSON=False
DEFAULT_FROM_EMAIL=SIAMS <no-reply@siams.local>

# Backing services (swap for managed cloud services in production)
POSTGRES_DB=siams
POSTGRES_USER=siams
POSTGRES_PASSWORD=siams
DATABASE_URL=postgres://siams:siams@db:5432/siams
REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=siams
RABBITMQ_DEFAULT_PASS=siams
CELERY_BROKER_URL=amqp://siams:siams@rabbitmq:5672//
EMAIL_URL=smtp://mailpit:1025

# File storage: filesystem | s3 | gcs | azure
# Development: files go to backend/media/YYYY/MM/DD/<category>/<uuid>.<ext>
STORAGE_BACKEND=filesystem
MEDIA_ROOT=/app/media
SIGNED_URL_SECONDS=60
# s3 (AWS S3 or any S3-compatible service; set AWS_S3_ENDPOINT_URL for MinIO/R2/Spaces)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# gcs
GS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
# azure
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=
# Which provider SDK to bake into the production image: s3 | gcs | azure
STORAGE_EXTRA=s3

# Auth
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1

# API docs (Swagger). Always enabled in dev; off by default in prod
ENABLE_API_DOCS=True
API_DOCS_PUBLIC=True

# Business defaults (read by Team Beta / Team Alpha services)
MAX_HOURS_PER_DAY=12
HOURS_OUTLIER_DAY=10
HOURS_OUTLIER_WEEK=60
MIN_ACTIVITY_CHARS=30
LATE_SUBMISSION_DAYS=7
REVIEW_REMINDER_HOURS=48
REVIEW_ESCALATION_HOURS=72
MAX_IMAGES_PER_WEEK=5
MAX_IMAGE_MB=5
MAX_REPORT_MB=10
REQUIRE_FINAL_REPORT_FOR_RESULT=True

# Production only
IMAGE_REPO=siams-backend
IMAGE_TAG=latest
SENTRY_DSN=
FRONTEND_URL=http://localhost
DASHBOARD_CACHE_SECONDS=30
